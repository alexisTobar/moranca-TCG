generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  SELLER
  BUYER
}

enum ListingType {
  SINGLE
  SEALED
  DECK
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  SHIPPED
}

enum CouponType {
  PERCENT
  FIXED
}

enum NewsCategory {
  MAGIC
  POKEMON
  ONEPIECE
  MYL
  GENERAL
}

model NewsItem {
  id          String       @id @default(cuid())
  category    NewsCategory
  title       String
  excerpt     String
  imageUrl    String?
  sourceUrl   String       @unique
  sourceName  String
  publishedAt DateTime
  fetchedAt   DateTime     @default(now())

  @@index([category, publishedAt])
  @@index([publishedAt])
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  slug      String    @unique
  password  String
  role      Role      @default(SELLER)
  active    Boolean   @default(true)
  avatarUrl String?
  bio       String?
  phone     String?
  city      String?

  // Datos de registro del comprador.
  rut     String?
  address String?

  // Cuenta bancaria del vendedor, la configura cada uno en su propio perfil.
  bankName          String?
  bankAccountType   String?
  bankAccountNumber String?
  bankHolderName    String?
  bankRut           String?

  // Descuentos configurables por el vendedor según método de pago (0-30%).
  transferDiscountPct Int @default(2)
  cashDiscountPct     Int @default(0)

  // Solicitud de comprador para pasar a vendedor.
  sellerRequestStatus  String?
  sellerRequestMessage String?
  sellerRequestAt      DateTime?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  listings       Listing[]
  buyerOrders    Order[]         @relation("BuyerOrders")
  sellerOrders   Order[]         @relation("SellerOrders")
  sentMessages   OrderMessage[]
  passwordResets PasswordReset[]
  coupons        Coupon[]
  receivedReviews Review[] @relation("SellerReviews")
  writtenReviews  Review[] @relation("BuyerReviews")

  @@index([active])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Listing {
  id          String        @id @default(cuid())
  type        ListingType
  status      ListingStatus @default(ACTIVE)
  game        String
  title       String
  slug        String        @unique
  imageUrl    String?
  price       Int
  offerPrice  Int?
  stock       Int           @default(1)
  condition   String?
  language    String?
  isFoil      Boolean       @default(false)
  description String?
  setName     String?
  cardNumber  String?
  rarity      String?
  color       String?
  family      String?
  illustrator String?
  externalId  String?
  featured    Boolean       @default(false)
  views       Int           @default(0)
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  deckCards   DeckCard[]
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([game, status])
  @@index([type, status])
  @@index([sellerId])
  @@index([createdAt])
}

model DeckCard {
  id         String  @id @default(cuid())
  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  externalId String?
  name       String
  imageUrl   String?
  quantity   Int     @default(1)
  setName    String?
  cardNumber String?
  category   String?
  position   Int     @default(0)

  @@index([listingId])
}

model Order {
  id                 String      @id @default(cuid())
  status             OrderStatus @default(PENDING)
  buyerId            String?
  buyer              User?       @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId           String?
  seller             User?       @relation("SellerOrders", fields: [sellerId], references: [id])
  buyerName          String
  buyerEmail         String
  buyerPhone         String?
  shipAddress        String?
  shipCity           String?
  shipRegion         String?
  shipMethod         String      @default("SHIPPING")
  shipCost           Int         @default(0)
  paymentMethod      String      @default("TRANSFER")
  discount           Int         @default(0)
  couponId           String?
  coupon             Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode         String?
  couponDiscount     Int         @default(0)
  paymentDiscountPct Int         @default(0)
  subtotal           Int         @default(0)
  total              Int
  preferenceId       String?
  paymentId          String?
  notes              String?
  items              OrderItem[]
  messages           OrderMessage[]
  review             Review?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([status])
  @@index([buyerId])
  @@index([sellerId])
  @@index([couponId])
}

model Review {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User     @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User     @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  sellerReply String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId, createdAt])
}

model Coupon {
  id        String     @id @default(cuid())
  sellerId  String
  seller    User       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  code      String
  type      CouponType @default(PERCENT)
  value     Int
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]

  @@unique([sellerId, code])
  @@index([sellerId, active])
}

model OrderMessage {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User     @relation(fields: [senderId], references: [id])
  body          String
  attachmentUrl String?
  createdAt     DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  title     String
  unitPrice Int
  quantity  Int

  @@index([orderId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Imágenes subidas a mano, para cartas o productos que no están en ninguna API.
model Upload {
  id         String   @id @default(cuid())
  mimeType   String
  size       Int
  data       Bytes
  filename   String?
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  SELLER
  BUYER
}

enum ListingType {
  SINGLE
  SEALED
  DECK
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  SHIPPED
  DELIVERED
}

enum CouponType {
  PERCENT
  FIXED
}

enum NewsCategory {
  MAGIC
  POKEMON
  ONEPIECE
  MYL
  GENERAL
}

model NewsItem {
  id          String       @id @default(cuid())
  category    NewsCategory
  title       String
  excerpt     String
  imageUrl    String?
  sourceUrl   String       @unique
  sourceName  String
  publishedAt DateTime
  fetchedAt   DateTime     @default(now())

  @@index([category, publishedAt])
  @@index([publishedAt])
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  slug      String    @unique
  password  String
  role      Role      @default(SELLER)
  active    Boolean   @default(true)
  avatarUrl String?
  bio       String?
  phone     String?
  city      String?

  // Datos de registro del comprador.
  rut     String?
  address String?

  // Cuenta bancaria del vendedor, la configura cada uno en su propio perfil.
  bankName          String?
  bankAccountType   String?
  bankAccountNumber String?
  bankHolderName    String?
  bankRut           String?

  // Descuentos configurables por el vendedor según método de pago (0-30%).
  transferDiscountPct Int @default(2)
  cashDiscountPct     Int @default(0)

  // Ubicación y formas de entrega del vendedor (para "cerca mío" y los filtros de entrega).
  // La comuna va en `city`; la región se guarda aparte.
  region         String?
  offersShipping Boolean @default(true)
  offersPickup   Boolean @default(true)

  // Constancia de que la persona aceptó los términos y la política de privacidad al registrarse.
  termsAcceptedAt DateTime?
  termsVersion    String?

  // Solicitud de comprador para pasar a vendedor.
  sellerRequestStatus  String?
  sellerRequestMessage String?
  sellerRequestAt      DateTime?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  listings       Listing[]
  buyerOrders    Order[]         @relation("BuyerOrders")
  sellerOrders   Order[]         @relation("SellerOrders")
  sentMessages   OrderMessage[]
  passwordResets PasswordReset[]
  coupons        Coupon[]
  store          Store?
  supportTickets SupportTicket[]
  receivedReviews Review[] @relation("SellerReviews")
  writtenReviews  Review[] @relation("BuyerReviews")

  @@index([active])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Listing {
  id          String        @id @default(cuid())
  type        ListingType
  status      ListingStatus @default(ACTIVE)
  game        String
  title       String
  slug        String        @unique
  imageUrl    String?
  price       Int
  offerPrice  Int?
  stock       Int           @default(1)
  condition   String?
  language    String?
  isFoil      Boolean       @default(false)
  description String?
  setName     String?
  cardNumber  String?
  rarity      String?
  color       String?
  family      String?
  illustrator String?
  externalId  String?
  featured    Boolean       @default(false)
  views       Int           @default(0)
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  deckCards   DeckCard[]
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([game, status])
  @@index([type, status])
  @@index([sellerId])
  @@index([createdAt])
}

model DeckCard {
  id         String  @id @default(cuid())
  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  externalId String?
  name       String
  imageUrl   String?
  quantity   Int     @default(1)
  setName    String?
  cardNumber String?
  category   String?
  position   Int     @default(0)

  @@index([listingId])
}

model Order {
  id                 String      @id @default(cuid())
  status             OrderStatus @default(PENDING)
  buyerId            String?
  buyer              User?       @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId           String?
  seller             User?       @relation("SellerOrders", fields: [sellerId], references: [id])
  buyerName          String
  buyerEmail         String
  buyerPhone         String?
  shipAddress        String?
  shipCity           String?
  shipRegion         String?
  shipMethod         String      @default("SHIPPING")
  shipCost           Int         @default(0)
  paymentMethod      String      @default("TRANSFER")
  discount           Int         @default(0)
  couponId           String?
  coupon             Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode         String?
  couponDiscount     Int         @default(0)
  paymentDiscountPct Int         @default(0)
  subtotal           Int         @default(0)
  total              Int
  preferenceId       String?
  paymentId          String?
  notes              String?

  /// Código único que el comprador pone en el comentario de la transferencia.
  paymentReference   String?
  /// Plazo para pagar. Vencido este plazo la orden se cancela y devuelve el stock.
  paymentDueAt       DateTime?
  /// Comprobante subido por el comprador (id de Upload, solo visible para las partes).
  receiptUploadId    String?
  receiptUploadedAt  DateTime?
  paidAt             DateTime?
  /// El stock de la orden está reservado (se descuenta al crear la orden).
  stockReserved      Boolean     @default(false)

  items              OrderItem[]
  messages           OrderMessage[]
  events             OrderEvent[]
  review             Review?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([status])
  @@index([status, paymentDueAt])
  @@index([paymentReference])
  @@index([buyerId])
  @@index([sellerId])
  @@index([couponId])
}

/// Historial de cada orden: quién hizo qué y cuándo (creación, comprobante, pago, envío, cancelación).
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId   String?
  type      String
  detail    String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/// Planes de tienda premium que define el administrador (precio, límites y beneficios).
model StorePlan {
  id            String              @id @default(cuid())
  code          String              @unique
  name          String
  description   String?
  priceMonthly  Int
  active        Boolean             @default(true)
  /// Cuántos productos puede destacar arriba de su tienda.
  maxFeatured   Int                 @default(6)
  advancedStats Boolean             @default(false)
  /// Puede aparecer en la vitrina "Tiendas destacadas" del inicio (si el admin lo activa).
  showcase      Boolean             @default(false)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  stores        Store[]
  subscriptions StoreSubscription[]
}

/// Tienda personalizable de un vendedor. Está "activa" solo con un plan vigente.
model Store {
  id                 String              @id @default(cuid())
  sellerId           String              @unique
  seller             User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  planId             String?
  plan               StorePlan?          @relation(fields: [planId], references: [id])
  /// ACTIVE o SUSPENDED (suspensión manual del administrador).
  status             String              @default("ACTIVE")
  activeUntil        DateTime?
  /// Aparece en la vitrina del inicio (lo decide el administrador).
  featured           Boolean             @default(false)
  displayName        String?
  tagline            String?
  about              String?
  logoUrl            String?
  bannerUrl          String?
  accentColor        String              @default("#c22443")
  instagram          String?
  facebook           String?
  whatsapp           String?
  website            String?
  announcement       String?
  featuredListingIds String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  visits             StoreVisitDay[]
  subscriptions      StoreSubscription[]

  @@index([status, activeUntil])
  @@index([featured])
}

/// Compra o renovación de un plan de tienda (pago por transferencia que revisa el administrador).
model StoreSubscription {
  id                String    @id @default(cuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId            String
  plan              StorePlan @relation(fields: [planId], references: [id])
  months            Int
  amount            Int
  /// PENDING, APPROVED o REJECTED.
  status            String    @default("PENDING")
  reference         String
  receiptUploadId   String?
  receiptUploadedAt DateTime?
  note              String?
  reviewedById      String?
  reviewedAt        DateTime?
  periodStart       DateTime?
  periodEnd         DateTime?
  createdAt         DateTime  @default(now())

  @@index([status, createdAt])
  @@index([storeId])
}

/// Visitas diarias a una tienda (y cuántas llegaron escaneando el QR).
model StoreVisitDay {
  id      String   @id @default(cuid())
  storeId String
  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  day     DateTime @db.Date
  views   Int      @default(0)
  qrScans Int      @default(0)

  @@unique([storeId, day])
}

/// Ticket de soporte: solo los vendedores con tienda vigente pueden abrirlos y los atiende el administrador.
model SupportTicket {
  id            String   @id @default(cuid())
  code          String   @unique
  sellerId      String
  seller        User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  subject       String
  /// PLAN | TIENDA | ORDEN | CUENTA | OTRO
  category      String   @default("OTRO")
  /// OPEN (espera al admin) | ANSWERED (espera al vendedor) | CLOSED
  status        String   @default("OPEN")
  adminUnread   Boolean  @default(true)
  sellerUnread  Boolean  @default(false)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([sellerId, lastMessageAt])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  fromAdmin Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

/// Foto diaria del precio de una carta (mínimo, mercado y máximo entre las ofertas activas),
/// por idioma. language = "*" es el resumen de todos los idiomas. Alimenta el gráfico de historial.
model PriceSnapshot {
  id          String   @id @default(cuid())
  game        String
  externalId  String
  language    String
  minPrice    Int
  marketPrice Int
  maxPrice    Int
  listings    Int
  day         DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([game, externalId, language, day])
  @@index([game, externalId, day])
}

/// Descuentos por método de pago que crea el administrador (2%, 5%, 10%…).
/// Solo uno puede estar activo por método; sin ninguno activo no hay descuento.
model PaymentDiscount {
  id        String   @id @default(cuid())
  method    String
  percent   Int
  label     String?
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([method, active])
}

/// Configuración global de la tienda (una sola fila, id = "site"). La edita el administrador.
/// Los campos *DiscountEnabled/Pct están en desuso: los descuentos viven en PaymentDiscount.
model SiteSetting {
  id                      String   @id @default("site")
  transferDiscountEnabled Boolean  @default(false)
  transferDiscountPct     Int      @default(0)
  cashDiscountEnabled     Boolean  @default(false)
  cashDiscountPct         Int      @default(0)
  /// Horas que tiene el comprador para pagar antes de que se cancele la orden.
  paymentWindowHours      Int      @default(48)
  updatedById             String?
  updatedAt               DateTime @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User     @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User     @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  sellerReply String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId, createdAt])
}

model Coupon {
  id        String     @id @default(cuid())
  sellerId  String
  seller    User       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  code      String
  type      CouponType @default(PERCENT)
  value     Int
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  orders    Order[]

  @@unique([sellerId, code])
  @@index([sellerId, active])
}

model OrderMessage {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User     @relation(fields: [senderId], references: [id])
  body          String
  attachmentUrl String?
  createdAt     DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  title     String
  unitPrice Int
  quantity  Int

  @@index([orderId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Imágenes subidas a mano, para cartas o productos que no están en ninguna API.
model Upload {
  id         String   @id @default(cuid())
  mimeType   String
  size       Int
  data       Bytes
  filename   String?
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

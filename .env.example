# ---------- Base de datos: Supabase (PostgreSQL) ----------
# Supabase → tu proyecto → Connect → ORMs → Prisma
#
# DATABASE_URL = "Transaction pooler" (puerto 6543). Es la que usa la app.
#                Debe llevar ?pgbouncer=true&connection_limit=10&pool_timeout=20
# DIRECT_URL   = "Session pooler" (puerto 5432). La usa Prisma para migraciones.
#
# Reemplaza [PASSWORD] por la clave de la base de datos y [PROJECT-REF]/[REGION]
# por los valores de tu proyecto.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------- Seguridad ----------
# Mínimo 32 caracteres. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas"

# ---------- Administrador inicial (usado por el seed) ----------
ADMIN_EMAIL="admin@dreamdecktcg.cl"
ADMIN_PASSWORD="DreamDeckTCG2026!"
ADMIN_NAME="Dream Deck TCG"

# ---------- Sitio ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Mercado Pago (opcional hasta que lo actives) ----------
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# ---------- Correo: recuperar contraseña (opcional) ----------
# Sin RESEND_API_KEY, el link de recuperación queda en los logs del servidor
# en vez de llegar por correo real. Crea una cuenta en https://resend.com,
# saca una API key y pégala acá.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Dream Deck TCG <onboarding@resend.dev>"

# ---------- APIs de cartas ----------
# Scryfall (Magic), dotGG (One Piece) y api.myl.cl NO requieren clave.
# pokemontcg.io funciona sin clave, pero con clave tiene mejor límite de uso.
POKEMONTCG_API_KEY=""

# ---------- TCGplayer (opcional) ----------
# Su API ya no entrega llaves nuevas: "We are no longer granting new API access
# at this time" (docs.tcgplayer.com/docs/getting-started). Si consigues acceso,
# pega las llaves aquí y los precios de Magic y One Piece pasan a venir de la
# API oficial. Sin llaves se usan los mismos precios redistribuidos por
# Scryfall, pokemontcg.io y dotGG.
TCGPLAYER_PUBLIC_KEY=""
TCGPLAYER_PRIVATE_KEY=""
